@echo off
rem  Bamep Issue #65 — WinPE plain-HTTP throughput CONTROL bootstrap. THROWAWAY LAB ONLY.
rem
rem  Injected into X:\Windows\System32 by the DERIVED Issue-65 autoexec.ipxe via
rem  wimboot's boot-time file overlay. The Issue #53 Phase-9d boot.wim / BCD /
rem  boot.sdi are NOT modified.
rem
rem  winpeshl.ini launches:  cmd.exe /k X:\Windows\System32\bamep-i65-bootstrap.cmd
rem  so this window stays open after the probe runs.
rem
rem  Sequence: wpeinit (network + PnP), then @TOTAL_TRANSFERS@ back-to-back plain
rem  WinHTTP POSTs of exactly 2 GiB each to the Fedora HTTP sink. Each POST is a
rem  fresh process, one WinHTTP session, one 32 MiB buffer sent 64 times. NO disk
rem  is touched on either side. transfer 1 = warmup, transfers 2..N = measured.
setlocal enabledelayedexpansion
echo [bamep-i65-http] wpeinit (network + PnP init)...
wpeinit

set "PROBE=X:\Windows\System32\bamep-i65-http-probe.exe"
set "HOST=@LAB_IP@"
set "PORT=@SINK_PORT@"

for /L %%i in (1,1,@TOTAL_TRANSFERS@) do (
  echo.
  echo [bamep-i65-http] ===== POST %%i / @TOTAL_TRANSFERS@ =====
  "%PROBE%" --host %HOST% --port %PORT% --path /i65-http-control --label t%%i --connect-wait-secs @CONNECT_WAIT_SECS@
  echo BAMEP_I65_HTTP_%%i_EXITCODE=!ERRORLEVEL!
)

echo.
echo BAMEP_I65_ALL_DONE
echo [bamep-i65-http] All @TOTAL_TRANSFERS@ POSTs complete. Read the throughput on
echo             the Fedora launcher terminal (i65_sink_result lines), then power
echo             the MiniPC off. This CMD stays open.
endlocal
